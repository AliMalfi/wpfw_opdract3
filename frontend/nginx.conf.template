# 1. Kwam de bezoeker binnen via https (Azure)? Geef dat door.
#    Geen header (lokaal)? Gebruik dan gewoon http.
map $http_x_forwarded_proto $echte_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    root /usr/share/nginx/html;

    # 2. Alles onder /api/ doorsturen naar de backend (API_URL)
    location /api/ {
        proxy_pass ${API_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $echte_proto;
    }

    # 3. React Router: onbekend pad -> index.html (verversen werkt)
    location / {
        try_files $uri $uri/ /index.html;
    }
}